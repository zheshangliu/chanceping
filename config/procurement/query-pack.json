  "scope_rules": [
    "先判公告/需求身份，再判断采购对象；菜单含采购词仍不是机会。",
    "纯IT设备、网络机房、道路施工、医疗器械、通用安保物业、食品供餐不因采购人是文化机构而纳入。",
    "含设计/创新/AI不能单独强相关；文化数字内容、文化IP和互动展陈有明确服务需求时可纳入。",
    "非遗活动中采购材料包或执行服务可以纳入；普通学员报名手工课/摊主付费入场不是采购订单。",
    "更正/延期不能作为无关消息丢弃，必须回连原项目；中标/终止归历史状态。",
    "买方地点、交付地点、来源地区、境外资格四个字段独立；未知资格显示查看原文，不猜。",
    "申请供应商库与真实订单两个不同子类型；佣金渠道与采购金额不同。"
  ],
  "optional_classification_codes": {
    "CPV_UNSPSC": "仅当来源提供或正式词表确认后使用；本包不凭记忆硬写未经验证的编码。中文/当地语言关键词与来源分类并用，不能只靠编码检索。"
  },
  "retrieval_budget": {
    "initial_window_days": 60,
    "initial_window_note": "这是起始搜索窗，不是候选数量上限。仍开放的更早项目、长期供应申请必须补全；大平台用更新水位与分类/关键词，不遍历所有历史。",
    "incremental_overlap_days": 7,
    "frequency_hours": 72,
    "short_window_risk": "72h可能遗漏短期采购；本轮保持现有周期，实际记录短窗遗漏风险，需要24h/12h时单独获批，不静默改比赛调度。"
