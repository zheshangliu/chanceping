# ChancePing 阿里云 MVP 环境变量样例
#
# 用途：
# - 复制这些变量名到阿里云 ECS / 容器服务 / 函数计算的环境变量配置。
# - 不要把真实 API Key 写进本文件。
# - 不要把本地 api.env 上传到服务器或镜像。

# Runtime
NODE_ENV=production
PORT=3000
DATA_MODE=mock
LLM_MODE=mock
STORE_TYPE=local

# Qwen contest profile
CHANCEPING_LLM_PROFILE=contest
CONTEST_LLM_PROVIDER=qwen
CONTEST_LLM_MODEL=
CONTEST_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTEST_LLM_API_KEY=

# Search provider
SERPER_API_KEY=

# Finance / HeadHunter protected workbench
FINANCE_ADMIN_USERNAME=
FINANCE_ADMIN_PASSWORD_HASH=
FINANCE_SESSION_SECRET=
# Set true for a temporary read-only public Finance page; POST/PATCH actions remain protected.
FINANCE_PUBLIC_MODE=false
CHANCEPING_HEADHUNTER_DATA_DIR=data/headhunter

# Production safety defaults
CHANCEPING_LOAD_API_ENV=false
CHANCEPING_ENABLE_LOCAL_LIVE_SEARCH=false
CHANCEPING_ENABLE_LOCAL_LIVE_LLM=false
SCHEDULER_ENABLED=true
NOTIFY_MOCK_MODE=true
PDF_EXPORT_ENABLED=false

# Local persistence paths inside the container / server.
# Mount data/reports/exports as persistent volumes when using Docker.
CHANCEPING_RADAR_CHAT_STORE_PATH=data/radar-chat-windows.json

# ICH source submissions. Production defaults to /var/lib/chanceping/ich;
# override the directory only when the host uses a different persistent volume.
CHANCEPING_ICH_RUNTIME_DIR=/var/lib/chanceping/ich
CHANCEPING_ICH_SUBMISSION_HMAC_SECRET=
CHANCEPING_ICH_ADMIN_TOKEN=
# Optional: Nginx combined access log used by the protected /ich/admin dashboard.
CHANCEPING_ICH_ACCESS_LOG_PATH=/var/log/nginx/access.log
